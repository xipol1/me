# Variables de entorno para la Plataforma de Monetización para Canales de Comunicación

# Configuración del servidor
PORT=5000
NODE_ENV=development

# Configuración de MongoDB
MONGODB_URI=mongodb://localhost:27017/plataforma_monetizacion

# JWT (JSON Web Token)
JWT_SECRET=tu_clave_secreta_jwt
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Email
EMAIL_SERVICE=gmail
EMAIL_USERNAME=tu_email@gmail.com
EMAIL_PASSWORD=tu_password_email
EMAIL_FROM=noreply@plataformamonetizacion.com
EMAIL_FROM_NAME=Plataforma de Monetización

# Stripe (Pagos)
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_stripe
STRIPE_WEBHOOK_SECRET=whsec_tu_clave_secreta_webhook

# PayPal
PAYPAL_CLIENT_ID=tu_client_id_paypal
PAYPAL_CLIENT_SECRET=tu_client_secret_paypal
PAYPAL_MODE=sandbox

# Comisión de la plataforma (porcentaje)
PLATFORM_COMMISSION_RATE=0.10

# Configuración de APIs externas
TELEGRAM_BOT_TOKEN=tu_token_bot_telegram
WHATSAPP_BUSINESS_API_TOKEN=tu_token_whatsapp_business
META_APP_ID=tu_app_id_meta
META_APP_SECRET=tu_app_secret_meta
DISCORD_BOT_TOKEN=tu_token_bot_discord

# Configuración de almacenamiento
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880 # 5MB
